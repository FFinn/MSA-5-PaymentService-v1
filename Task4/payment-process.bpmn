<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_OrchestrPay" targetNamespace="https://orchestrpay.example/payment" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.22.0">
  <bpmn:message id="Message_FraudAllow" name="Антифрод разрешил" />
  <bpmn:message id="Message_FraudDeny" name="Антифрод запретил" />
  <bpmn:message id="Message_FraudManual" name="Антифрод запросил ручную проверку" />
  <bpmn:message id="Message_ManualAllow" name="Оператор разрешил" />
  <bpmn:message id="Message_ManualDeny" name="Оператор запретил" />
  <bpmn:process id="Process_OrchestrPayPayment" name="OrchestrPay: обработка платежа и компенсации Saga" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Payment" name="Старт">
      <bpmn:outgoing>Flow_Start_CheckIdempotency</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckIdempotency" name="Проверить ключ идемпотентности запуска" camunda:type="external" camunda:topic="Task_CheckIdempotency">
      <bpmn:incoming>Flow_Start_CheckIdempotency</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckIdempotency_PaymentExists</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PaymentExists" name="Платёж уже создан?" default="Flow_PaymentNotExists_CreatePayment">
      <bpmn:incoming>Flow_CheckIdempotency_PaymentExists</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentExists_ReturnSaved</bpmn:outgoing>
      <bpmn:outgoing>Flow_PaymentNotExists_CreatePayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ReturnSavedResult" name="Вернуть сохранённый результат" camunda:type="external" camunda:topic="Task_ReturnSavedResult">
      <bpmn:incoming>Flow_PaymentExists_ReturnSaved</bpmn:incoming>
      <bpmn:outgoing>Flow_ReturnSaved_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ExistingPayment" name="Конец">
      <bpmn:incoming>Flow_ReturnSaved_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreatePayment" name="CREATE_PAYMENT: создать платёж, экземпляр Saga и outbox-запись" camunda:type="external" camunda:topic="Task_CreatePayment">
      <bpmn:incoming>Flow_PaymentNotExists_CreatePayment</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatePayment_Precheck</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Precheck" name="Проверить входные данные и лимиты" camunda:type="external" camunda:topic="Task_Precheck">
      <bpmn:incoming>Flow_CreatePayment_Precheck</bpmn:incoming>
      <bpmn:outgoing>Flow_Precheck_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PrecheckPassed" name="Предварительная проверка пройдена?" default="Flow_PrecheckFailed_Cancel">
      <bpmn:incoming>Flow_Precheck_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_PrecheckPassed_Debit</bpmn:outgoing>
      <bpmn:outgoing>Flow_PrecheckFailed_Cancel</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CancelPrecheck" name="CANCEL_PAYMENT" camunda:type="external" camunda:topic="Task_CancelPrecheck">
      <bpmn:incoming>Flow_PrecheckFailed_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_CancelPrecheck_Rejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SetRejectedPrecheck" name="Зафиксировать REJECTED" camunda:type="external" camunda:topic="Task_SetRejectedPrecheck">
      <bpmn:incoming>Flow_CancelPrecheck_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectedPrecheck_Outbox</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_OutboxPrecheckNotification" name="Записать уведомление клиенту в outbox" camunda:type="external" camunda:topic="Task_OutboxPrecheckNotification">
      <bpmn:incoming>Flow_RejectedPrecheck_Outbox</bpmn:incoming>
      <bpmn:outgoing>Flow_OutboxPrecheck_Closed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ClosedPrecheck" name="CLOSED" camunda:type="external" camunda:topic="Task_ClosedPrecheck">
      <bpmn:incoming>Flow_OutboxPrecheck_Closed</bpmn:incoming>
      <bpmn:outgoing>Flow_ClosedPrecheck_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PrecheckRejected" name="Конец">
      <bpmn:incoming>Flow_ClosedPrecheck_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_DebitPayer" name="DEBIT_PAYER_ACCOUNT: отправить команду списания с ключом идемпотентности" camunda:type="external" camunda:topic="Task_DebitPayer">
      <bpmn:incoming>Flow_PrecheckPassed_Debit</bpmn:incoming>
      <bpmn:outgoing>Flow_Debit_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DebitResponse" name="Первичный ответ на списание?" default="Flow_DebitUnknown_SaveRecon">
      <bpmn:incoming>Flow_Debit_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DebitConfirmed_Debited</bpmn:outgoing>
      <bpmn:outgoing>Flow_DebitRefused_Cancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_DebitUnknown_SaveRecon</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SaveDebitReconciliation" name="Сохранить DEBIT_RECONCILIATION" camunda:type="external" camunda:topic="Task_SaveDebitReconciliation">
      <bpmn:incoming>Flow_DebitUnknown_SaveRecon</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveDebitRecon_Query</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_QueryDebitStatus" name="QUERY_DEBIT_STATUS: запросить фактический статус списания" camunda:type="external" camunda:topic="Task_QueryDebitStatus">
      <bpmn:incoming>Flow_SaveDebitRecon_Query</bpmn:incoming>
      <bpmn:incoming>Flow_DebitRetry_Query</bpmn:incoming>
      <bpmn:outgoing>Flow_QueryDebitStatus_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DebitStatus" name="Статус списания установлен?" default="Flow_DebitStatusUnknown_Wait">
      <bpmn:incoming>Flow_QueryDebitStatus_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_DebitStatusConfirmed_Debited</bpmn:outgoing>
      <bpmn:outgoing>Flow_DebitStatusNone_Cancel</bpmn:outgoing>
      <bpmn:outgoing>Flow_DebitStatusUnknown_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_DebitReconWait" name="Ожидать повтор сверки или срок">
      <bpmn:incoming>Flow_DebitStatusUnknown_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_DebitWait_RetryTimer</bpmn:outgoing>
      <bpmn:outgoing>Flow_DebitWait_DeadlineTimer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_DebitRetryTimer" name="Таймер следующей попытки сверки списания">
      <bpmn:incoming>Flow_DebitWait_RetryTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_DebitRetry_Query</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${debitRetryDelay}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_DebitReconDeadline" name="Срок сверки списания истёк">
      <bpmn:incoming>Flow_DebitWait_DeadlineTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_DebitDeadline_FinRecon</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${debitReconciliationTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_FinReconDebit" name="FINANCIAL_RECONCILIATION_REQUIRED: инцидент по списанию" camunda:type="external" camunda:topic="Task_FinReconDebit">
      <bpmn:incoming>Flow_DebitDeadline_FinRecon</bpmn:incoming>
      <bpmn:outgoing>Flow_FinReconDebit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_FinReconDebit" name="Ожидание сверки">
      <bpmn:incoming>Flow_FinReconDebit_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Debited" name="DEBITED: сохранить идентификатор списания" camunda:type="external" camunda:topic="Task_Debited">
      <bpmn:incoming>Flow_DebitConfirmed_Debited</bpmn:incoming>
      <bpmn:incoming>Flow_DebitStatusConfirmed_Debited</bpmn:incoming>
      <bpmn:outgoing>Flow_Debited_FraudRequest</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CancelDebit" name="CANCEL_PAYMENT" camunda:type="external" camunda:topic="Task_CancelDebit">
      <bpmn:incoming>Flow_DebitRefused_Cancel</bpmn:incoming>
      <bpmn:incoming>Flow_DebitStatusNone_Cancel</bpmn:incoming>
      <bpmn:outgoing>Flow_CancelDebit_Rejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SetRejectedDebit" name="Зафиксировать REJECTED" camunda:type="external" camunda:topic="Task_SetRejectedDebit">
      <bpmn:incoming>Flow_CancelDebit_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_RejectedDebit_Outbox</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_OutboxDebitNotification" name="Записать уведомление клиенту в outbox" camunda:type="external" camunda:topic="Task_OutboxDebitNotification">
      <bpmn:incoming>Flow_RejectedDebit_Outbox</bpmn:incoming>
      <bpmn:outgoing>Flow_OutboxDebit_Closed</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ClosedDebit" name="CLOSED" camunda:type="external" camunda:topic="Task_ClosedDebit">
      <bpmn:incoming>Flow_OutboxDebit_Closed</bpmn:incoming>
      <bpmn:outgoing>Flow_ClosedDebit_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_DebitRejected" name="Конец">
      <bpmn:incoming>Flow_ClosedDebit_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_FraudRequest" name="REQUEST_FRAUD_CHECK: запросить антифрод-проверку" camunda:type="external" camunda:topic="Task_FraudRequest">
      <bpmn:incoming>Flow_Debited_FraudRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudRequest_Wait</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SaveFraudChecking" name="Сохранить FRAUD_CHECKING" camunda:type="external" camunda:topic="Task_SaveFraudChecking">
      <bpmn:incoming>Flow_FraudRequest_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveFraudChecking_EventGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_FraudEvents" name="Ответ антифрода или cut-off">
      <bpmn:incoming>Flow_SaveFraudChecking_EventGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudEvents_Allow</bpmn:outgoing>
      <bpmn:outgoing>Flow_FraudEvents_Deny</bpmn:outgoing>
      <bpmn:outgoing>Flow_FraudEvents_Manual</bpmn:outgoing>
      <bpmn:outgoing>Flow_FraudEvents_Cutoff</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_FraudAllow" name="Получено разрешение антифрода">
      <bpmn:incoming>Flow_FraudEvents_Allow</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudAllow_Approved</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_FraudAllow" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_FraudDeny" name="Получен запрет антифрода">
      <bpmn:incoming>Flow_FraudEvents_Deny</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudDeny_Security</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_FraudDeny" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_FraudManual" name="Антифрод запросил ручную проверку">
      <bpmn:incoming>Flow_FraudEvents_Manual</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudManual_SaveWait</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_FraudManual" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_FraudCutoffTimer" name="Контрольный срок антифрода истёк">
      <bpmn:incoming>Flow_FraudEvents_Cutoff</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudCutoff_Approve</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${fraudCutoffTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_FraudAllowApproved" name="Назначить маршрут «перевод»: разрешение антифрода" camunda:type="external" camunda:topic="Task_FraudAllowApproved">
      <bpmn:incoming>Flow_FraudAllow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudAllow_ToApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_FraudCutoffApprove" name="APPROVE_BY_CUTOFF: сохранить причину истечения срока антифрода" camunda:type="external" camunda:topic="Task_FraudCutoffApprove">
      <bpmn:incoming>Flow_FraudCutoff_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_FraudCutoff_ToApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SaveManualReviewWait" name="REQUEST_MANUAL_REVIEW: сохранить MANUAL_REVIEW_WAIT" camunda:type="external" camunda:topic="Task_SaveManualReviewWait">
      <bpmn:incoming>Flow_FraudManual_SaveWait</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveManual_EventGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_ManualEvents" name="Решение оператора или 20 минут">
      <bpmn:incoming>Flow_SaveManual_EventGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualEvents_Allow</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManualEvents_Deny</bpmn:outgoing>
      <bpmn:outgoing>Flow_ManualEvents_Cutoff</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_ManualAllow" name="Оператор разрешил">
      <bpmn:incoming>Flow_ManualEvents_Allow</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualAllow_Approved</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ManualAllow" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ManualDeny" name="Оператор запретил">
      <bpmn:incoming>Flow_ManualEvents_Deny</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualDeny_Security</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_ManualDeny" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ManualCutoffTimer" name="20 минут ручной проверки истекли">
      <bpmn:incoming>Flow_ManualEvents_Cutoff</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualCutoff_Approve</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20M</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_ManualAllowApproved" name="Назначить маршрут «перевод»: разрешение оператора" camunda:type="external" camunda:topic="Task_ManualAllowApproved">
      <bpmn:incoming>Flow_ManualAllow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualAllow_ToApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ManualCutoffApprove" name="APPROVE_BY_CUTOFF: сохранить причину истечения 20 минут ручной проверки" camunda:type="external" camunda:topic="Task_ManualCutoffApprove">
      <bpmn:incoming>Flow_ManualCutoff_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_ManualCutoff_ToApproved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Approved" name="APPROVED: маршрут «перевод»" camunda:type="external" camunda:topic="Task_Approved">
      <bpmn:incoming>Flow_FraudAllow_ToApproved</bpmn:incoming>
      <bpmn:incoming>Flow_FraudCutoff_ToApproved</bpmn:incoming>
      <bpmn:incoming>Flow_ManualAllow_ToApproved</bpmn:incoming>
      <bpmn:incoming>Flow_ManualCutoff_ToApproved</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_Transfer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SecurityFraud" name="Создать событие для системы безопасности" camunda:type="external" camunda:topic="Task_SecurityFraud">
      <bpmn:incoming>Flow_FraudDeny_Security</bpmn:incoming>
      <bpmn:incoming>Flow_ManualDeny_Security</bpmn:incoming>
      <bpmn:outgoing>Flow_Security_RefundRoute</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RefundRoute" name="Назначить маршрут «возврат»" camunda:type="external" camunda:topic="Task_RefundRoute">
      <bpmn:incoming>Flow_Security_RefundRoute</bpmn:incoming>
      <bpmn:incoming>Flow_TransferNone_RefundRoute</bpmn:incoming>
      <bpmn:incoming>Flow_TransferStatusNone_RefundRoute</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundRoute_RefundCommand</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:textAnnotation id="TextAnnotation_EventRace" name="Ответ антифрода, решение оператора и таймер конкурируют по версии экземпляра Saga. Побеждает первое сохранённое событие; поздний ответ только журналируется и не создаёт второй перевод или возврат.">
      <bpmn:text>Ответ антифрода, решение оператора и таймер конкурируют по версии экземпляра Saga. Побеждает первое сохранённое событие; поздний ответ только журналируется и не создаёт второй перевод или возврат.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Pivot" name="Pivot-точка: подтверждённый перевод контрагенту. До COMPLETED возможен автоматический REFUND_PAYER; после COMPLETED возврат в этой Saga не запускается.">
      <bpmn:text>Pivot-точка: подтверждённый перевод контрагенту. До COMPLETED возможен автоматический REFUND_PAYER; после COMPLETED возврат в этой Saga не запускается.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:serviceTask id="Task_TransferToCounterparty" name="TRANSFER_TO_COUNTERPARTY: отправить команду перевода" camunda:type="external" camunda:topic="Task_TransferToCounterparty">
      <bpmn:incoming>Flow_Approved_Transfer</bpmn:incoming>
      <bpmn:outgoing>Flow_Transfer_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_TransferResponse" name="Первичный ответ на перевод?" default="Flow_TransferUnknown_SaveRecon">
      <bpmn:incoming>Flow_Transfer_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_TransferConfirmed_Completed</bpmn:outgoing>
      <bpmn:outgoing>Flow_TransferNone_RefundRoute</bpmn:outgoing>
      <bpmn:outgoing>Flow_TransferUnknown_SaveRecon</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SaveTransferReconciliation" name="Сохранить TRANSFER_RECONCILIATION" camunda:type="external" camunda:topic="Task_SaveTransferReconciliation">
      <bpmn:incoming>Flow_TransferUnknown_SaveRecon</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveTransferRecon_Query</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_QueryTransferStatus" name="QUERY_TRANSFER_STATUS: запросить фактический статус перевода" camunda:type="external" camunda:topic="Task_QueryTransferStatus">
      <bpmn:incoming>Flow_SaveTransferRecon_Query</bpmn:incoming>
      <bpmn:incoming>Flow_TransferRetry_Query</bpmn:incoming>
      <bpmn:outgoing>Flow_QueryTransferStatus_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_TransferStatus" name="Статус перевода установлен?" default="Flow_TransferStatusUnknown_Wait">
      <bpmn:incoming>Flow_QueryTransferStatus_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_TransferStatusConfirmed_Completed</bpmn:outgoing>
      <bpmn:outgoing>Flow_TransferStatusNone_RefundRoute</bpmn:outgoing>
      <bpmn:outgoing>Flow_TransferStatusUnknown_Wait</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_TransferReconWait" name="Ожидать повтор сверки или срок">
      <bpmn:incoming>Flow_TransferStatusUnknown_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_TransferWait_RetryTimer</bpmn:outgoing>
      <bpmn:outgoing>Flow_TransferWait_DeadlineTimer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_TransferRetryTimer" name="Таймер следующей попытки сверки перевода">
      <bpmn:incoming>Flow_TransferWait_RetryTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_TransferRetry_Query</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${transferRetryDelay}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_TransferReconDeadline" name="Срок сверки перевода истёк">
      <bpmn:incoming>Flow_TransferWait_DeadlineTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_TransferDeadline_FinRecon</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${transferReconciliationTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_FinReconTransfer" name="FINANCIAL_RECONCILIATION_REQUIRED: инцидент по переводу" camunda:type="external" camunda:topic="Task_FinReconTransfer">
      <bpmn:incoming>Flow_TransferDeadline_FinRecon</bpmn:incoming>
      <bpmn:outgoing>Flow_FinReconTransfer_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_FinReconTransfer" name="Ожидание сверки">
      <bpmn:incoming>Flow_FinReconTransfer_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_Completed" name="COMPLETED: перевод подтверждён, pivot-точка пройдена" camunda:type="external" camunda:topic="Task_Completed">
      <bpmn:incoming>Flow_TransferConfirmed_Completed</bpmn:incoming>
      <bpmn:incoming>Flow_TransferStatusConfirmed_Completed</bpmn:incoming>
      <bpmn:outgoing>Flow_Completed_ParallelFork</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_SuccessFork" name="Параллельно">
      <bpmn:incoming>Flow_Completed_ParallelFork</bpmn:incoming>
      <bpmn:outgoing>Flow_SuccessFork_NotifyCustomer</bpmn:outgoing>
      <bpmn:outgoing>Flow_SuccessFork_AuditPivot</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_NotifyCustomerSuccess" name="Создать уведомление клиенту в таблице исходящих сообщений" camunda:type="external" camunda:topic="Task_NotifyCustomerSuccess">
      <bpmn:incoming>Flow_SuccessFork_NotifyCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyCustomerSuccess_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AuditPivot" name="Зафиксировать аудит прохождения pivot-точки" camunda:type="external" camunda:topic="Task_AuditPivot">
      <bpmn:incoming>Flow_SuccessFork_AuditPivot</bpmn:incoming>
      <bpmn:outgoing>Flow_AuditPivot_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_SuccessJoin" name="Объединить ветви">
      <bpmn:incoming>Flow_NotifyCustomerSuccess_Join</bpmn:incoming>
      <bpmn:incoming>Flow_AuditPivot_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_SuccessJoin_Closed</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_ClosedSuccess" name="CLOSED" camunda:type="external" camunda:topic="Task_ClosedSuccess">
      <bpmn:incoming>Flow_SuccessJoin_Closed</bpmn:incoming>
      <bpmn:outgoing>Flow_ClosedSuccess_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Success" name="Конец">
      <bpmn:incoming>Flow_ClosedSuccess_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_RefundPayer" name="REFUND_PAYER: автоматический возврат с тем же ключом идемпотентности" camunda:type="external" camunda:topic="Task_RefundPayer">
      <bpmn:incoming>Flow_RefundRoute_RefundCommand</bpmn:incoming>
      <bpmn:incoming>Flow_RefundRetry_RefundCommand</bpmn:incoming>
      <bpmn:incoming>Flow_RefundStatusRetry_RefundCommand</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundCommand_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RefundResponse" name="Первичный ответ на возврат?" default="Flow_RefundUnknown_SaveRecon">
      <bpmn:incoming>Flow_RefundCommand_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundConfirmed_Refunded</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefundAbsent_CheckRetry</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefundUnknown_SaveRecon</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CheckRefundRetry" name="Определить, можно ли безопасно повторить возврат" camunda:type="external" camunda:topic="Task_CheckRefundRetry">
      <bpmn:incoming>Flow_RefundAbsent_CheckRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckRefundRetry_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RefundRetryAllowed" name="Ошибка повторяема?" default="Flow_RefundRetryRequired">
      <bpmn:incoming>Flow_CheckRefundRetry_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundRetry_RefundCommand</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefundRetryRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SaveRefundReconciliation" name="Сохранить REFUND_RECONCILIATION" camunda:type="external" camunda:topic="Task_SaveRefundReconciliation">
      <bpmn:incoming>Flow_RefundUnknown_SaveRecon</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveRefundRecon_Query</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_QueryRefundStatus" name="QUERY_REFUND_STATUS: запросить фактический статус возврата" camunda:type="external" camunda:topic="Task_QueryRefundStatus">
      <bpmn:incoming>Flow_SaveRefundRecon_Query</bpmn:incoming>
      <bpmn:incoming>Flow_RefundStatusLoop</bpmn:incoming>
      <bpmn:outgoing>Flow_QueryRefundStatus_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RefundStatus" name="Статус возврата установлен?" default="Flow_RefundStatusUnknown_Wait">
      <bpmn:incoming>Flow_QueryRefundStatus_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundStatusConfirmed_Refunded</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefundStatusRetry_RefundCommand</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefundStatusUnknown_Wait</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefundStatusRequired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_RefundReconWait" name="Ожидать повтор сверки или срок">
      <bpmn:incoming>Flow_RefundStatusUnknown_Wait</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundWait_RetryTimer</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefundWait_DeadlineTimer</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_RefundRetryTimer" name="Таймер следующей попытки сверки возврата">
      <bpmn:incoming>Flow_RefundWait_RetryTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundStatusLoop</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${refundRetryDelay}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_RefundReconDeadline" name="Срок сверки возврата истёк">
      <bpmn:incoming>Flow_RefundWait_DeadlineTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundStatusRequired</bpmn:outgoing>
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${refundReconciliationTimeout}</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_Refunded" name="REFUNDED: возврат подтверждён" camunda:type="external" camunda:topic="Task_Refunded">
      <bpmn:incoming>Flow_RefundConfirmed_Refunded</bpmn:incoming>
      <bpmn:incoming>Flow_RefundStatusConfirmed_Refunded</bpmn:incoming>
      <bpmn:outgoing>Flow_Refunded_ParallelFork</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_RefundFork" name="Параллельно">
      <bpmn:incoming>Flow_Refunded_ParallelFork</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundFork_NotifyCustomer</bpmn:outgoing>
      <bpmn:outgoing>Flow_RefundFork_NotifySecurity</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_NotifyCustomerRefund" name="Создать уведомление клиенту в таблице исходящих сообщений" camunda:type="external" camunda:topic="Task_NotifyCustomerRefund">
      <bpmn:incoming>Flow_RefundFork_NotifyCustomer</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyCustomerRefund_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifySecurityRefund" name="Создать событие безопасности в таблице исходящих сообщений" camunda:type="external" camunda:topic="Task_NotifySecurityRefund">
      <bpmn:incoming>Flow_RefundFork_NotifySecurity</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifySecurityRefund_Join</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_RefundJoin" name="Объединить ветви">
      <bpmn:incoming>Flow_NotifyCustomerRefund_Join</bpmn:incoming>
      <bpmn:incoming>Flow_NotifySecurityRefund_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundJoin_Closed</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_ClosedRefund" name="CLOSED" camunda:type="external" camunda:topic="Task_ClosedRefund">
      <bpmn:incoming>Flow_RefundJoin_Closed</bpmn:incoming>
      <bpmn:outgoing>Flow_ClosedRefund_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Refund" name="Конец">
      <bpmn:incoming>Flow_ClosedRefund_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_RefundReconciliationRequired" name="REFUND_RECONCILIATION_REQUIRED: срочный инцидент финансовой сверки" camunda:type="external" camunda:topic="Task_RefundReconciliationRequired">
      <bpmn:incoming>Flow_RefundRetryRequired</bpmn:incoming>
      <bpmn:incoming>Flow_RefundStatusRequired</bpmn:incoming>
      <bpmn:incoming>Flow_RefundDeadline_Required</bpmn:incoming>
      <bpmn:outgoing>Flow_RefundRequired_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_RefundRequired" name="Ожидание сверки">
      <bpmn:incoming>Flow_RefundRequired_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:association id="Association_EventRace_Fraud" sourceRef="TextAnnotation_EventRace" targetRef="Gateway_FraudEvents" />
    <bpmn:association id="Association_EventRace_Manual" sourceRef="TextAnnotation_EventRace" targetRef="Gateway_ManualEvents" />
    <bpmn:association id="Association_Pivot_Transfer" sourceRef="TextAnnotation_Pivot" targetRef="Task_TransferToCounterparty" />
    <bpmn:sequenceFlow id="Flow_Start_CheckIdempotency" sourceRef="StartEvent_Payment" targetRef="Task_CheckIdempotency" />
    <bpmn:sequenceFlow id="Flow_CheckIdempotency_PaymentExists" sourceRef="Task_CheckIdempotency" targetRef="Gateway_PaymentExists" />
    <bpmn:sequenceFlow id="Flow_PaymentExists_ReturnSaved" name="да" sourceRef="Gateway_PaymentExists" targetRef="Task_ReturnSavedResult">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentExists == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReturnSaved_End" sourceRef="Task_ReturnSavedResult" targetRef="EndEvent_ExistingPayment" />
    <bpmn:sequenceFlow id="Flow_PaymentNotExists_CreatePayment" name="нет" sourceRef="Gateway_PaymentExists" targetRef="Task_CreatePayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentExists == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CreatePayment_Precheck" sourceRef="Task_CreatePayment" targetRef="Task_Precheck" />
    <bpmn:sequenceFlow id="Flow_Precheck_Gateway" sourceRef="Task_Precheck" targetRef="Gateway_PrecheckPassed" />
    <bpmn:sequenceFlow id="Flow_PrecheckPassed_Debit" name="да" sourceRef="Gateway_PrecheckPassed" targetRef="Task_DebitPayer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${precheckPassed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PrecheckFailed_Cancel" name="нет" sourceRef="Gateway_PrecheckPassed" targetRef="Task_CancelPrecheck">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${precheckPassed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CancelPrecheck_Rejected" sourceRef="Task_CancelPrecheck" targetRef="Task_SetRejectedPrecheck" />
    <bpmn:sequenceFlow id="Flow_RejectedPrecheck_Outbox" sourceRef="Task_SetRejectedPrecheck" targetRef="Task_OutboxPrecheckNotification" />
    <bpmn:sequenceFlow id="Flow_OutboxPrecheck_Closed" sourceRef="Task_OutboxPrecheckNotification" targetRef="Task_ClosedPrecheck" />
    <bpmn:sequenceFlow id="Flow_ClosedPrecheck_End" sourceRef="Task_ClosedPrecheck" targetRef="EndEvent_PrecheckRejected" />
    <bpmn:sequenceFlow id="Flow_Debit_Gateway" sourceRef="Task_DebitPayer" targetRef="Gateway_DebitResponse" />
    <bpmn:sequenceFlow id="Flow_DebitConfirmed_Debited" name="списание подтверждено" sourceRef="Gateway_DebitResponse" targetRef="Task_Debited">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${debitResponse == "CONFIRMED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DebitRefused_Cancel" name="банк отказал" sourceRef="Gateway_DebitResponse" targetRef="Task_CancelDebit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${debitResponse == "REFUSED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DebitUnknown_SaveRecon" name="тайм-аут / сеть / 5xx" sourceRef="Gateway_DebitResponse" targetRef="Task_SaveDebitReconciliation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${debitResponse == "UNKNOWN"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CancelDebit_Rejected" sourceRef="Task_CancelDebit" targetRef="Task_SetRejectedDebit" />
    <bpmn:sequenceFlow id="Flow_RejectedDebit_Outbox" sourceRef="Task_SetRejectedDebit" targetRef="Task_OutboxDebitNotification" />
    <bpmn:sequenceFlow id="Flow_OutboxDebit_Closed" sourceRef="Task_OutboxDebitNotification" targetRef="Task_ClosedDebit" />
    <bpmn:sequenceFlow id="Flow_ClosedDebit_End" sourceRef="Task_ClosedDebit" targetRef="EndEvent_DebitRejected" />
    <bpmn:sequenceFlow id="Flow_SaveDebitRecon_Query" sourceRef="Task_SaveDebitReconciliation" targetRef="Task_QueryDebitStatus" />
    <bpmn:sequenceFlow id="Flow_QueryDebitStatus_Gateway" sourceRef="Task_QueryDebitStatus" targetRef="Gateway_DebitStatus" />
    <bpmn:sequenceFlow id="Flow_DebitStatusConfirmed_Debited" name="списание подтверждено" sourceRef="Gateway_DebitStatus" targetRef="Task_Debited">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${debitStatus == "CONFIRMED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DebitStatusNone_Cancel" name="списания нет" sourceRef="Gateway_DebitStatus" targetRef="Task_CancelDebit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${debitStatus == "ABSENT"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DebitStatusUnknown_Wait" name="статус неизвестен" sourceRef="Gateway_DebitStatus" targetRef="Gateway_DebitReconWait">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${debitStatus == "UNKNOWN"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DebitWait_RetryTimer" name="следующая попытка" sourceRef="Gateway_DebitReconWait" targetRef="Event_DebitRetryTimer" />
    <bpmn:sequenceFlow id="Flow_DebitRetry_Query" sourceRef="Event_DebitRetryTimer" targetRef="Task_QueryDebitStatus" />
    <bpmn:sequenceFlow id="Flow_DebitWait_DeadlineTimer" name="срок сверки истёк" sourceRef="Gateway_DebitReconWait" targetRef="Event_DebitReconDeadline" />
    <bpmn:sequenceFlow id="Flow_DebitDeadline_FinRecon" sourceRef="Event_DebitReconDeadline" targetRef="Task_FinReconDebit" />
    <bpmn:sequenceFlow id="Flow_FinReconDebit_End" sourceRef="Task_FinReconDebit" targetRef="EndEvent_FinReconDebit" />
    <bpmn:sequenceFlow id="Flow_Debited_FraudRequest" sourceRef="Task_Debited" targetRef="Task_FraudRequest" />
    <bpmn:sequenceFlow id="Flow_FraudRequest_Wait" sourceRef="Task_FraudRequest" targetRef="Task_SaveFraudChecking" />
    <bpmn:sequenceFlow id="Flow_SaveFraudChecking_EventGateway" sourceRef="Task_SaveFraudChecking" targetRef="Gateway_FraudEvents" />
    <bpmn:sequenceFlow id="Flow_FraudEvents_Allow" name="разрешить" sourceRef="Gateway_FraudEvents" targetRef="Event_FraudAllow" />
    <bpmn:sequenceFlow id="Flow_FraudEvents_Deny" name="запретить" sourceRef="Gateway_FraudEvents" targetRef="Event_FraudDeny" />
    <bpmn:sequenceFlow id="Flow_FraudEvents_Manual" name="ручная проверка" sourceRef="Gateway_FraudEvents" targetRef="Event_FraudManual" />
    <bpmn:sequenceFlow id="Flow_FraudEvents_Cutoff" name="контрольный срок" sourceRef="Gateway_FraudEvents" targetRef="Event_FraudCutoffTimer" />
    <bpmn:sequenceFlow id="Flow_FraudAllow_Approved" sourceRef="Event_FraudAllow" targetRef="Task_FraudAllowApproved" />
    <bpmn:sequenceFlow id="Flow_FraudAllow_ToApproved" sourceRef="Task_FraudAllowApproved" targetRef="Task_Approved" />
    <bpmn:sequenceFlow id="Flow_FraudDeny_Security" sourceRef="Event_FraudDeny" targetRef="Task_SecurityFraud" />
    <bpmn:sequenceFlow id="Flow_FraudCutoff_Approve" sourceRef="Event_FraudCutoffTimer" targetRef="Task_FraudCutoffApprove" />
    <bpmn:sequenceFlow id="Flow_FraudCutoff_ToApproved" sourceRef="Task_FraudCutoffApprove" targetRef="Task_Approved" />
    <bpmn:sequenceFlow id="Flow_FraudManual_SaveWait" sourceRef="Event_FraudManual" targetRef="Task_SaveManualReviewWait" />
    <bpmn:sequenceFlow id="Flow_SaveManual_EventGateway" sourceRef="Task_SaveManualReviewWait" targetRef="Gateway_ManualEvents" />
    <bpmn:sequenceFlow id="Flow_ManualEvents_Allow" name="разрешить" sourceRef="Gateway_ManualEvents" targetRef="Event_ManualAllow" />
    <bpmn:sequenceFlow id="Flow_ManualEvents_Deny" name="запретить" sourceRef="Gateway_ManualEvents" targetRef="Event_ManualDeny" />
    <bpmn:sequenceFlow id="Flow_ManualEvents_Cutoff" name="20 минут" sourceRef="Gateway_ManualEvents" targetRef="Event_ManualCutoffTimer" />
    <bpmn:sequenceFlow id="Flow_ManualAllow_Approved" sourceRef="Event_ManualAllow" targetRef="Task_ManualAllowApproved" />
    <bpmn:sequenceFlow id="Flow_ManualAllow_ToApproved" sourceRef="Task_ManualAllowApproved" targetRef="Task_Approved" />
    <bpmn:sequenceFlow id="Flow_ManualDeny_Security" sourceRef="Event_ManualDeny" targetRef="Task_SecurityFraud" />
    <bpmn:sequenceFlow id="Flow_ManualCutoff_Approve" sourceRef="Event_ManualCutoffTimer" targetRef="Task_ManualCutoffApprove" />
    <bpmn:sequenceFlow id="Flow_ManualCutoff_ToApproved" sourceRef="Task_ManualCutoffApprove" targetRef="Task_Approved" />
    <bpmn:sequenceFlow id="Flow_Security_RefundRoute" sourceRef="Task_SecurityFraud" targetRef="Task_RefundRoute" />
    <bpmn:sequenceFlow id="Flow_Approved_Transfer" sourceRef="Task_Approved" targetRef="Task_TransferToCounterparty" />
    <bpmn:sequenceFlow id="Flow_Transfer_Gateway" sourceRef="Task_TransferToCounterparty" targetRef="Gateway_TransferResponse" />
    <bpmn:sequenceFlow id="Flow_TransferConfirmed_Completed" name="перевод подтверждён" sourceRef="Gateway_TransferResponse" targetRef="Task_Completed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferResponse == "CONFIRMED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TransferNone_RefundRoute" name="провайдер подтвердил отсутствие перевода" sourceRef="Gateway_TransferResponse" targetRef="Task_RefundRoute">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferResponse == "ABSENT"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TransferUnknown_SaveRecon" name="тайм-аут / сеть / 5xx" sourceRef="Gateway_TransferResponse" targetRef="Task_SaveTransferReconciliation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferResponse == "UNKNOWN"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SaveTransferRecon_Query" sourceRef="Task_SaveTransferReconciliation" targetRef="Task_QueryTransferStatus" />
    <bpmn:sequenceFlow id="Flow_QueryTransferStatus_Gateway" sourceRef="Task_QueryTransferStatus" targetRef="Gateway_TransferStatus" />
    <bpmn:sequenceFlow id="Flow_TransferStatusConfirmed_Completed" name="перевод подтверждён" sourceRef="Gateway_TransferStatus" targetRef="Task_Completed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferStatus == "CONFIRMED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TransferStatusNone_RefundRoute" name="перевода нет" sourceRef="Gateway_TransferStatus" targetRef="Task_RefundRoute">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferStatus == "ABSENT"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TransferStatusUnknown_Wait" name="статус неизвестен" sourceRef="Gateway_TransferStatus" targetRef="Gateway_TransferReconWait">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferStatus == "UNKNOWN"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TransferWait_RetryTimer" name="следующая попытка" sourceRef="Gateway_TransferReconWait" targetRef="Event_TransferRetryTimer" />
    <bpmn:sequenceFlow id="Flow_TransferRetry_Query" sourceRef="Event_TransferRetryTimer" targetRef="Task_QueryTransferStatus" />
    <bpmn:sequenceFlow id="Flow_TransferWait_DeadlineTimer" name="срок сверки истёк" sourceRef="Gateway_TransferReconWait" targetRef="Event_TransferReconDeadline" />
    <bpmn:sequenceFlow id="Flow_TransferDeadline_FinRecon" sourceRef="Event_TransferReconDeadline" targetRef="Task_FinReconTransfer" />
    <bpmn:sequenceFlow id="Flow_FinReconTransfer_End" sourceRef="Task_FinReconTransfer" targetRef="EndEvent_FinReconTransfer" />
    <bpmn:sequenceFlow id="Flow_Completed_ParallelFork" sourceRef="Task_Completed" targetRef="Gateway_SuccessFork" />
    <bpmn:sequenceFlow id="Flow_SuccessFork_NotifyCustomer" sourceRef="Gateway_SuccessFork" targetRef="Task_NotifyCustomerSuccess" />
    <bpmn:sequenceFlow id="Flow_SuccessFork_AuditPivot" sourceRef="Gateway_SuccessFork" targetRef="Task_AuditPivot" />
    <bpmn:sequenceFlow id="Flow_NotifyCustomerSuccess_Join" sourceRef="Task_NotifyCustomerSuccess" targetRef="Gateway_SuccessJoin" />
    <bpmn:sequenceFlow id="Flow_AuditPivot_Join" sourceRef="Task_AuditPivot" targetRef="Gateway_SuccessJoin" />
    <bpmn:sequenceFlow id="Flow_SuccessJoin_Closed" sourceRef="Gateway_SuccessJoin" targetRef="Task_ClosedSuccess" />
    <bpmn:sequenceFlow id="Flow_ClosedSuccess_End" sourceRef="Task_ClosedSuccess" targetRef="EndEvent_Success" />
    <bpmn:sequenceFlow id="Flow_RefundRoute_RefundCommand" sourceRef="Task_RefundRoute" targetRef="Task_RefundPayer" />
    <bpmn:sequenceFlow id="Flow_RefundCommand_Gateway" sourceRef="Task_RefundPayer" targetRef="Gateway_RefundResponse" />
    <bpmn:sequenceFlow id="Flow_RefundConfirmed_Refunded" name="возврат подтверждён" sourceRef="Gateway_RefundResponse" targetRef="Task_Refunded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundResponse == "CONFIRMED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RefundAbsent_CheckRetry" name="банк подтвердил отсутствие возврата" sourceRef="Gateway_RefundResponse" targetRef="Task_CheckRefundRetry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundResponse == "ABSENT"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RefundUnknown_SaveRecon" name="тайм-аут / сеть / 5xx" sourceRef="Gateway_RefundResponse" targetRef="Task_SaveRefundReconciliation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundResponse == "UNKNOWN"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CheckRefundRetry_Gateway" sourceRef="Task_CheckRefundRetry" targetRef="Gateway_RefundRetryAllowed" />
    <bpmn:sequenceFlow id="Flow_RefundRetry_RefundCommand" name="да" sourceRef="Gateway_RefundRetryAllowed" targetRef="Task_RefundPayer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundRetryable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RefundRetryRequired" name="нет" sourceRef="Gateway_RefundRetryAllowed" targetRef="Task_RefundReconciliationRequired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundRetryable == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_SaveRefundRecon_Query" sourceRef="Task_SaveRefundReconciliation" targetRef="Task_QueryRefundStatus" />
    <bpmn:sequenceFlow id="Flow_QueryRefundStatus_Gateway" sourceRef="Task_QueryRefundStatus" targetRef="Gateway_RefundStatus" />
    <bpmn:sequenceFlow id="Flow_RefundStatusConfirmed_Refunded" name="возврат подтверждён" sourceRef="Gateway_RefundStatus" targetRef="Task_Refunded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundStatus == "CONFIRMED"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RefundStatusRetry_RefundCommand" name="возврата нет, можно повторить" sourceRef="Gateway_RefundStatus" targetRef="Task_RefundPayer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundStatus == "ABSENT" and refundStatusRetryable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RefundStatusRequired" name="срок сверки истёк или повторять небезопасно" sourceRef="Gateway_RefundStatus" targetRef="Task_RefundReconciliationRequired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundStatus == "ABSENT_NOT_RETRYABLE"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RefundStatusUnknown_Wait" name="статус неизвестен" sourceRef="Gateway_RefundStatus" targetRef="Gateway_RefundReconWait">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${refundStatus == "UNKNOWN"}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RefundWait_RetryTimer" name="следующая попытка" sourceRef="Gateway_RefundReconWait" targetRef="Event_RefundRetryTimer" />
    <bpmn:sequenceFlow id="Flow_RefundStatusLoop" sourceRef="Event_RefundRetryTimer" targetRef="Task_QueryRefundStatus" />
    <bpmn:sequenceFlow id="Flow_RefundWait_DeadlineTimer" name="срок сверки истёк" sourceRef="Gateway_RefundReconWait" targetRef="Event_RefundReconDeadline" />
    <bpmn:sequenceFlow id="Flow_RefundDeadline_Required" sourceRef="Event_RefundReconDeadline" targetRef="Task_RefundReconciliationRequired" />
    <bpmn:sequenceFlow id="Flow_Refunded_ParallelFork" sourceRef="Task_Refunded" targetRef="Gateway_RefundFork" />
    <bpmn:sequenceFlow id="Flow_RefundFork_NotifyCustomer" sourceRef="Gateway_RefundFork" targetRef="Task_NotifyCustomerRefund" />
    <bpmn:sequenceFlow id="Flow_RefundFork_NotifySecurity" sourceRef="Gateway_RefundFork" targetRef="Task_NotifySecurityRefund" />
    <bpmn:sequenceFlow id="Flow_NotifyCustomerRefund_Join" sourceRef="Task_NotifyCustomerRefund" targetRef="Gateway_RefundJoin" />
    <bpmn:sequenceFlow id="Flow_NotifySecurityRefund_Join" sourceRef="Task_NotifySecurityRefund" targetRef="Gateway_RefundJoin" />
    <bpmn:sequenceFlow id="Flow_RefundJoin_Closed" sourceRef="Gateway_RefundJoin" targetRef="Task_ClosedRefund" />
    <bpmn:sequenceFlow id="Flow_ClosedRefund_End" sourceRef="Task_ClosedRefund" targetRef="EndEvent_Refund" />
    <bpmn:sequenceFlow id="Flow_RefundRequired_End" sourceRef="Task_RefundReconciliationRequired" targetRef="EndEvent_RefundRequired" />
  </bpmn:process>
