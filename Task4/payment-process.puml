@startuml
title OrchestrPay — обработка платежа и компенсации Saga

skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #E8F1FB
  BorderColor #2463A5
  DiamondBackgroundColor #FFF6DB
  DiamondBorderColor #C58A00
  BarColor #2463A5
}
skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
}

start

:Проверить ключ идемпотентности запуска;
if (Платёж уже создан?) then (да)
  :Вернуть сохранённый результат;
  stop
endif

:В одной локальной транзакции создать платёж,
экземпляр Saga и запись в таблице исходящих сообщений;

:Проверить входные данные и лимиты;
if (Предварительная проверка пройдена?) then (да)
  :Продолжить проведение платежа;
else (нет)
  :Выполнить CANCEL_PAYMENT;
  :Зафиксировать REJECTED и создать
уведомление клиенту в таблице исходящих сообщений;
  :Сохранить CLOSED;
  stop
endif

:Отправить команду на списание
с неизменным ключом идемпотентности;

if (Первичный ответ на списание?) then (списание подтверждено)
  :Сохранить идентификатор списания
и состояние DEBITED;
elseif (банк отказал)
  :Сохранить, что списания не было;
else (тайм-аут, сеть или 5xx)
  :Перейти в DEBIT_RECONCILIATION;
  repeat
    :Запросить у банка фактический
статус списания;
    if (Статус установлен?) then (да)
      :Сохранить подтверждённый результат;
    else (нет)
      :Ожидать следующую попытку сверки;
    endif
  repeat while (Статус неизвестен и срок сверки не истёк?) is (да)
endif

if (Списание подтверждено?) then (да)
  :Запросить антифрод-проверку
с идентификатором платежа;
else (нет или статус не установлен)
  if (Статус списания не установлен?) then (да)
    :Сохранить FINANCIAL_RECONCILIATION_REQUIRED
и создать инцидент для финансовой сверки;
    note right
      Нельзя повторить списание или отменить платёж:
      банк мог выполнить операцию, но ответ потерялся.
    end note
    stop
  else (банк подтвердил отсутствие списания)
    :Выполнить CANCEL_PAYMENT;
    :Зафиксировать REJECTED и создать
уведомление клиенту в таблице исходящих сообщений;
    :Сохранить CLOSED;
    stop
  endif
endif

if (Решение антифрода?) then (разрешить)
  :Назначить маршрут «перевод»;
elseif (запретить)
  :Назначить маршрут «возврат»;
  :Создать событие для системы безопасности;
elseif (ручная проверка)
  :Сохранить MANUAL_REVIEW_WAIT
и ожидать решение оператора до 20 минут;
  if (Первым сохранённым исходом стало?) then (разрешить)
    :Назначить маршрут «перевод»;
  elseif (запретить)
    :Назначить маршрут «возврат»;
    :Создать событие для системы безопасности;
  else (истёк контрольный срок)
    :Зафиксировать разрешение
по контрольному сроку;
    :Назначить маршрут «перевод»;
  endif
else (нет ответа)
  :Сохранить FRAUD_CHECKING и ожидать
ответ антифрода или контрольный срок;
  if (Первым сохранённым исходом стало?) then (разрешить)
    :Назначить маршрут «перевод»;
  elseif (запретить)
    :Назначить маршрут «возврат»;
    :Создать событие для системы безопасности;
  elseif (ручная проверка)
    :Сохранить MANUAL_REVIEW_WAIT
и ожидать решение оператора до 20 минут;
    if (Первым сохранённым исходом стало?) then (разрешить)
      :Назначить маршрут «перевод»;
    elseif (запретить)
      :Назначить маршрут «возврат»;
      :Создать событие для системы безопасности;
    else (истёк контрольный срок)
      :Зафиксировать разрешение
по контрольному сроку;
      :Назначить маршрут «перевод»;
    endif
  else (истёк контрольный срок)
    :Зафиксировать разрешение
по контрольному сроку;
    :Назначить маршрут «перевод»;
  endif
endif

note right
Ответ антифрода, решение оператора и таймер конкурируют по версии экземпляра Saga.
Побеждает первое сохранённое решение; поздний ответ только журналируется.
end note

if (Маршрут — перевод?) then (да)
  note right
    Pivot-точка находится на подтверждённом переводе.
    До COMPLETED возможен автоматический REFUND_PAYER;
    после COMPLETED возврат в этой Saga не запускается.
  end note

  :Отправить команду на перевод контрагенту
с неизменным ключом идемпотентности;

  if (Первичный ответ на перевод?) then (перевод подтверждён)
    :Сохранить COMPLETED —
точка невозврата пройдена;
    fork
      :Создать уведомление клиенту
в таблице исходящих сообщений;
    fork again
      :Зафиксировать аудит прохождения
pivot-точки;
    end fork
    :Сохранить CLOSED;
    stop
  elseif (провайдер подтвердил, что перевода не было)
    :Назначить маршрут «возврат»;
  else (тайм-аут, сеть или 5xx)
    :Перейти в TRANSFER_RECONCILIATION;
    repeat
      :Запросить у провайдера фактический
статус перевода;
      if (Статус установлен?) then (да)
        :Сохранить подтверждённый результат;
      else (нет)
        :Ожидать следующую попытку сверки;
      endif
    repeat while (Статус неизвестен и срок сверки не истёк?) is (да)

    if (Перевод подтверждён?) then (да)
      :Сохранить COMPLETED —
точка невозврата пройдена;
      fork
        :Создать уведомление клиенту
в таблице исходящих сообщений;
      fork again
        :Зафиксировать аудит прохождения
pivot-точки;
      end fork
      :Сохранить CLOSED;
      stop
    elseif (Провайдер подтвердил отсутствие перевода?) then (да)
      :Назначить маршрут «возврат»;
    else (статус не установлен)
      :Сохранить FINANCIAL_RECONCILIATION_REQUIRED
и создать инцидент для финансовой сверки;
      note right
        До установления факта перевода
        возврат выполнять нельзя.
      end note
      stop
    endif
  endif
endif

if (Маршрут — возврат?) then (да)
  repeat
    :Отправить команду REFUND_PAYER
с тем же ключом идемпотентности;

    if (Первичный ответ на возврат?) then (возврат подтверждён)
      :Сохранить подтверждённый результат;
    elseif (банк подтвердил отсутствие возврата)
      :Определить, можно ли безопасно
повторить операцию;
    else (тайм-аут, сеть или 5xx)
      :Перейти в REFUND_RECONCILIATION;
      repeat
        :Запросить у банка фактический
статус возврата;
        if (Статус установлен?) then (да)
          :Сохранить подтверждённый результат;
        else (нет)
          :Ожидать следующую попытку сверки;
        endif
      repeat while (Статус неизвестен и срок сверки не истёк?) is (да)
    endif
  repeat while (Возврат не подтверждён, но ошибка повторяема
и не истёк срок автоматических попыток?) is (да)

  if (Возврат подтверждён?) then (да)
    :Сохранить REFUNDED;
    fork
      :Создать уведомление клиенту
в таблице исходящих сообщений;
    fork again
      :Создать событие безопасности
в таблице исходящих сообщений;
    end fork
    :Сохранить CLOSED;
    stop
  else (нет или статус не установлен)
    :Сохранить состояние
REFUND_RECONCILIATION_REQUIRED;
    :Создать срочный инцидент для финансовой сверки;
    note right
      Клиенту не сообщается о возврате,
      пока банк его не подтвердил.
    end note
    stop
  endif
endif

@enduml
