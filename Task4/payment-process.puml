@startuml
title OrchestrPay — обработка платежа по Saga

skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #E8F1FB
  BorderColor #2463A5
  DiamondBackgroundColor #FFF6DB
  DiamondBorderColor #C58A00
  BarColor #2463A5
}
skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
}

start
:Создать платёж
и экземпляр Saga;

if (Можно перейти к списанию?) then (да)
else (нет)
  :Компенсировать создание:
отменить платёж
(CANCEL_PAYMENT);
  stop
endif

:Списать деньги
со счёта плательщика
(DEBIT_PAYER_ACCOUNT);

if (Результат списания?) then (списано)
  :Зафиксировать подтверждённое списание;
elseif (банк отказал)
  :Зафиксировать отказ платежа:
деньги не списаны;
  :Записать уведомление клиенту
в таблицу исходящих сообщений;
  stop
else (ответ неясен)
  :Перевести процесс в состояние
DEBIT_RECONCILIATION;

  while (Ответ банка не получен?) is (да)
    :Уточнить статус списания
у банка;
  endwhile (нет)

  if (Списание выполнено?) then (да)
    :Зафиксировать подтверждённое списание;
  else (нет)
    :Зафиксировать отказ платежа:
деньги не списаны;
    :Записать уведомление клиенту
в таблицу исходящих сообщений;
    stop
  endif
endif

:Запросить антифрод-проверку
(REQUEST_FRAUD_CHECK);
:Ожидать ответ антифрод-сервиса
до контрольного срока;

if (Ответ антифрода получен?) then (да)
  if (Решение антифрода?) then (разрешить)
    :Разрешить платёж;
  elseif (ручная проверка)
    :Перевести процесс в состояние
MANUAL_REVIEW_WAIT;
    :Ожидать решение оператора
не более 20 минут;

    if (Ответ оператора получен?) then (да)
      if (Решение оператора?) then (разрешить)
        :Разрешить платёж;
      else (запретить)
        :Компенсировать списание:
вернуть деньги плательщику
(REFUND_PAYER);
        :Зафиксировать возврат
и записать уведомления клиенту
и системе безопасности
в таблицу исходящих сообщений;
        stop
      endif
    else (нет, срок истёк)
      :Разрешить платёж
по контрольному сроку;
    endif

  else (запретить)
    :Компенсировать списание:
вернуть деньги плательщику
(REFUND_PAYER);
    :Зафиксировать возврат
и записать уведомления клиенту
и системе безопасности
в таблицу исходящих сообщений;
    stop
  endif

else (нет, срок истёк)
  :Разрешить платёж
по контрольному сроку;
endif

:Отправить идемпотентную команду
на перевод контрагенту
(TRANSFER_TO_COUNTERPARTY);
note right
Точка невозврата:
после подтверждения перевода
компенсация списания не выполняется.
При неясном ответе сначала
проводится сверка статуса.
end note

if (Ответ провайдера?) then (перевод подтверждён)
  :Зафиксировать успешный
финансовый результат;
  :Записать уведомление клиенту
в таблицу исходящих сообщений;
  stop

elseif (ответ неясен)
  :Перевести процесс в состояние
TRANSFER_RECONCILIATION;

  while (Ответ провайдера не получен?) is (да)
    :Уточнить фактический
статус перевода;
  endwhile (нет)

  if (Перевод проведён?) then (да)
    :Зафиксировать успешный
финансовый результат;
    :Записать уведомление клиенту
в таблицу исходящих сообщений;
    stop
  else (нет, провайдер подтвердил)
    :Компенсировать списание:
вернуть деньги плательщику
(REFUND_PAYER);
    :Перевести процесс в состояние
REFUND_RECONCILIATION;

    while (Возврат не подтверждён?) is (да)
      :Уточнить статус возврата;
      if (Банк подтвердил, что возврата не было?) then (да)
        :Повторить возврат
с прежним ключом идемпотентности;
      endif
    endwhile (нет)

    :Зафиксировать возврат
и записать уведомление клиенту
в таблицу исходящих сообщений;
    stop
  endif

else (перевод отклонён)
  :Компенсировать списание:
вернуть деньги плательщику
(REFUND_PAYER);
  :Перевести процесс в состояние
REFUND_RECONCILIATION;

  while (Возврат не подтверждён?) is (да)
    :Уточнить статус возврата;
    if (Банк подтвердил, что возврата не было?) then (да)
      :Повторить возврат
с прежним ключом идемпотентности;
    endif
  endwhile (нет)

  :Зафиксировать возврат
и записать уведомление клиенту
в таблицу исходящих сообщений;
  stop
endif

@enduml
