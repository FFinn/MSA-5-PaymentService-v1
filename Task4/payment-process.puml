@startuml
title OrchestrPay — обработка платежа по Saga

skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #E8F1FB
  BorderColor #2463A5
  DiamondBackgroundColor #FFF6DB
  DiamondBorderColor #C58A00
  BarColor #2463A5
}
skinparam note {
  BackgroundColor #F8FAFC
  BorderColor #94A3B8
}

start
:Создать платёж
и экземпляр Saga;
:Списать деньги
со счёта плательщика;
:Запросить антифрод-проверку;

if (Решение антифрода?) then (разрешить)
  :Разрешить платёж;
elseif (ручная проверка)
  :Ожидать решение оператора
не более 20 минут;

  if (Ответ оператора получен?) then (да)
    if (Решение оператора?) then (разрешить)
      :Разрешить платёж;
    else (запретить)
      :Вернуть деньги
плательщику;
      fork
        :Уведомить клиента;
      fork again
        :Передать сведения
в систему безопасности;
      end fork
      stop
    endif
  else (нет, срок истёк)
    :Разрешить платёж
по контрольному сроку;
  endif

else (ответ не получен)
  :Разрешить платёж
по контрольному сроку;
endif

:Перевести деньги
контрагенту;
note right
Точка невозврата:
после подтверждения перевода
автоматический возврат не выполняется.
end note

if (Ответ провайдера?) then (перевод подтверждён)
  fork
    :Зафиксировать успешный
финансовый результат;
  fork again
    :Уведомить клиента;
  end fork
  stop

elseif (ответ неясен)
  :Уточнить фактический
результат перевода;

  if (Перевод проведён?) then (да)
    fork
      :Зафиксировать успешный
финансовый результат;
    fork again
      :Уведомить клиента;
    end fork
    stop
  else (нет)
    :Вернуть деньги
плательщику;
    fork
      :Уведомить клиента;
    fork again
      :Передать сведения
в систему безопасности;
    end fork
    stop
  endif

else (перевод отклонён)
  :Вернуть деньги
плательщику;
  fork
    :Уведомить клиента;
  fork again
    :Передать сведения
в систему безопасности;
  end fork
  stop
endif

@enduml
